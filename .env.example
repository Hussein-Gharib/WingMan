# ---- Neon PostgreSQL ----
# Pooled connection string from your Neon project dashboard.
# Server-side only. NEVER expose this to the browser (no NEXT_PUBLIC_ prefix).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/wingman?sslmode=require

# ---- Vercel Blob ----
# Read/write token from Vercel > Storage > your Blob store > Tokens.
# Used only for admin-uploaded images. Server-side only.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ---- Admin authentication ----
# The single password used to log in to /admin.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign the admin session cookie (HS256).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
